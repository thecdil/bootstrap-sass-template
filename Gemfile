# frozen_string_literal: true

source 'https://rubygems.org'

# needed for Jekyll
gem "jekyll", "= 4.4.1"
# local web server for `jekyll serve`
gem 'webrick'
# stdlib gems that are no longer bundled with current Ruby versions
gem 'logger'
gem 'base64'
gem 'ostruct'

# Sass compiler used by Jekyll to build Bootstrap from the source in _sass.
# Ruby Sass and SassC are end-of-life; sass-embedded (Dart Sass) is the
# current supported compiler and is what jekyll-sass-converter 3.x uses.
gem 'sass-embedded'
# adds vendor prefixes to the compiled css, matching official Bootstrap builds;
# used by the _plugins/autoprefixer.rb hook. Requires a JS runtime (e.g. Node)
gem 'autoprefixer-rails'
